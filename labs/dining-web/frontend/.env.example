# 배포된 dining-web HTTP API 엔드포인트 (끝 슬래시는 있어도 무방 — 코드에서 정규화).
# 실제 값은 .env.local에 넣습니다(.gitignore의 *.local로 커밋 제외).
# 값 조회:
#   aws cloudformation describe-stacks --stack-name dining-web \
#     --query "Stacks[0].Outputs[?OutputKey=='ApiUrl'].OutputValue | [0]" --output text
VITE_API_URL=https://your-api-id.execute-api.us-west-2.amazonaws.com
