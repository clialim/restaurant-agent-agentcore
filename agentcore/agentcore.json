{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "RestaurantAgent",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "RestaurantAgent"
  },
  "runtimes": [
    {
      "name": "RestaurantAgent",
      "codeLocation": "app/RestaurantAgent",
      "entrypoint": "main.py",
      "build": "CodeZip",
      "runtimeVersion": "PYTHON_3_13",
      "networkMode": "PUBLIC"
    },
    {
      "name": "CodingService",
      "codeLocation": "app/CodingService",
      "entrypoint": "main.py",
      "build": "Container",
      "dockerfile": "Dockerfile",
      "protocol": "HTTP",
      "networkMode": "PUBLIC",
      "envVars": [
        {
          "name": "BEDROCK_MODEL_ID",
          "value": "us.amazon.nova-lite-v1:0"
        },
        {
          "name": "WORKSPACE_ROOT",
          "value": "/mnt/workspace"
        }
      ],
      "filesystemConfigurations": [
        {
          "sessionStorage": {
            "mountPath": "/mnt/workspace"
          }
        }
      ]
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "payments": []
}